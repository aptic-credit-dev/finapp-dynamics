# Stage-7 staging environment — EXAMPLE values only. Copy to .env.staging and set LOCAL values.
# NON-PRODUCTION. Never put real secrets, production credentials, or real customer data here.

# --- Node ---
NODE_ENV=staging
API_PORT=3000

# --- PostgreSQL 16 (staging container) ---
# The container superuser runs migrations + seed; the kernel SET ROLEs to the non-owner app role per query,
# so RLS is exercised as a real non-superuser. finapp_owner / finapp_app are created by the migrations.
POSTGRES_DB=finapp_staging
POSTGRES_USER=postgres
# Placeholder only — set a local-only value in .env.staging (compose reads it); never commit a real value.
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Connection: the superuser connects; the kernel applies SET ROLE finapp_app (NOBYPASSRLS) per query.
DATABASE_URL=postgresql://postgres:CHANGE_ME_LOCAL_ONLY@db:5432/finapp_staging
DATABASE_OWNER_ROLE=finapp_owner
DATABASE_APP_ROLE=finapp_app
# Optional connection-pool size (concurrency knob only; no effect on RLS/RBAC/audit). Leave blank for the
# node-postgres default (10). For write-concurrency headroom set e.g. 32; keep <= PostgreSQL max_connections (100).
DATABASE_POOL_MAX=

# --- Auth / CORS (staging; the app's production guards still apply when NODE_ENV=production) ---
FINAPP_ALLOWED_ORIGINS=http://localhost:3000
FINAPP_COOKIE_SECURE=false
FINAPP_COOKIE_SAMESITE=Lax

# First-administrator bootstrap (ADR-020). Leave unset for a documented dev/test no-op, or name a synthetic
# account created by bootstrap-synthetic.mjs. NEVER a real production admin.
# FINAPP_BOOTSTRAP_ADMIN_ACCOUNT=

# --- Connectors / secrets: intentionally UNSET ---
# No production connector endpoints or credentials. Connectors stay fail-closed (framework-only ports).
# No production secret provider is configured (M41 SecretProviderPort stays fail-closed).
#
# OpenBao (ADR-132): leave ALL blank to keep M41 fail-closed (default). To bind the approved OpenBao instance
# (once the dedicated host exists), set these — SECRET_ID is a secret, supply out-of-band, NEVER commit:
# FINAPP_OPENBAO_ADDR=            # https URL of the OpenBao instance (TLS required)
# FINAPP_OPENBAO_CA_CERT_PEM=     # PEM CA bundle to verify the server cert
# FINAPP_OPENBAO_AUTH_METHOD=approle
# FINAPP_OPENBAO_ROLE_ID=         # from deploy/openbao provisioning (store securely)
# FINAPP_OPENBAO_SECRET_ID=       # wrapped SecretID, unwrapped once (out-of-band); never commit
# FINAPP_OPENBAO_TRANSIT_MOUNT=transit
# FINAPP_OPENBAO_TRANSIT_KEY_PREFIX=finapp-
# FINAPP_OPENBAO_TIMEOUT_MS=5000
