# OpenBao deploy env (copy to .env.openbao; NEVER commit real values). Placeholders only — no secrets.
OPENBAO_IMAGE=openbao/openbao:latest
# Host paths for config / TLS material / audit sink (provided out-of-band; not committed):
OPENBAO_CONFIG_DIR=./config
OPENBAO_TLS_DIR=./tls
OPENBAO_AUDIT_DIR=./audit

# --- The API (finapp) side — set these in the API's own runtime env, NOT here (shown for reference) ---
# FINAPP_OPENBAO_ADDR=https://openbao.internal:8200      # required; must be https (TLS)
# FINAPP_OPENBAO_CA_CERT_PEM=                            # PEM CA bundle to verify the server cert (recommended)
# FINAPP_OPENBAO_AUTH_METHOD=approle                     # approle (preferred) | token
# FINAPP_OPENBAO_ROLE_ID=                                # from setup.sh (store securely)
# FINAPP_OPENBAO_SECRET_ID=                              # unwrapped ONCE from the wrapped SecretID (out-of-band)
# FINAPP_OPENBAO_TRANSIT_MOUNT=transit
# FINAPP_OPENBAO_TRANSIT_KEY_PREFIX=finapp-
# FINAPP_OPENBAO_TIMEOUT_MS=5000
# FINAPP_OPENBAO_TLS_SKIP_VERIFY=                        # leave BLANK; '1' only for throwaway local testing
