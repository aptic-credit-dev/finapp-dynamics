# Stage-7 DR env (copy to .env.dr on the host; NEVER commit real values). Placeholders only — no secrets.
PGBACKREST_STANZA=aptic
PGDATA=/var/lib/postgresql/16/main

# --- Off-provider immutable store (Backblaze B2, S3-compatible). Region = Legal/Kenya-DPA-approved. ---
B2_S3_ENDPOINT=            # e.g. s3.<region>.backblazeb2.com
B2_S3_REGION=
B2_BUCKET=                 # dedicated backup bucket with Object Lock (WORM) enabled
B2_KEY_ID=                 # WRITE-ONLY / append-only application key id
B2_APP_KEY=               # application key secret — inject from a root-only file; NEVER commit
PGBACKREST_CIPHER_PASS=   # client-side backup encryption passphrase — custody tied to OpenBao; NEVER commit

# --- Standby / replication ---
PRIMARY_HOST=             # primary private address (for the standby)
REPLICATION_SLOT=standby1
MAX_LAG_BYTES=16777216
MAX_BACKUP_AGE_H=26
